<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>ArbiPache</AssemblyName>
    <RootNamespace>ArbiPache.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ArbiPache.Core\ArbiPache.Core.csproj" />
    <!-- Puts ArbiPache.Agent.exe next to ArbiPache.exe, so both resolve the same portable root. -->
    <ProjectReference Include="..\ArbiPache.Agent\ArbiPache.Agent.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ArbiPache.App.Tests" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\catalog\components.json" Link="catalog\components.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
