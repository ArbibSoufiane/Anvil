<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ArbiPache.App.ViewModels"
             x:Class="ArbiPache.App.Views.LogsView"
             x:DataType="vm:LogsViewModel">
  <DockPanel>
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <StackPanel Orientation="Horizontal" Spacing="16" DockPanel.Dock="Right" VerticalAlignment="Center">
        <CheckBox Content="Follow" IsChecked="{Binding Follow}" />
        <CheckBox Content="Errors only" IsChecked="{Binding ErrorsOnly}" />
        <Button Classes="ghost" Content="Open file" Command="{Binding OpenFileCommand}" />
        <Button Classes="ghost" Content="Logs folder" Command="{Binding OpenFolderCommand}" />
      </StackPanel>
      <ItemsControl x:Name="Sources" ItemsSource="{Binding Sources}" VerticalAlignment="Center">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel ItemSpacing="8" LineSpacing="8" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:SourceChip">
            <Button Classes="chip" Classes.on="{Binding IsSelected}" Content="{Binding Label}"
                    Command="{Binding $parent[UserControl].((vm:LogsViewModel)DataContext).SelectCommand}"
                    CommandParameter="{Binding}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </DockPanel>

    <Border Classes="logPanel">
      <Grid>
        <ListBox x:Name="LogList" Classes="log" ItemsSource="{Binding Lines}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:LogLine">
              <DockPanel>
                <TextBlock Classes="logSource" Text="{Binding Source}" DockPanel.Dock="Left" />
                <TextBlock Classes="logText" Classes.error="{Binding IsError}" Classes.warn="{Binding IsWarning}" Text="{Binding Text}" />
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Classes="note" Text="Nothing logged yet." HorizontalAlignment="Center" VerticalAlignment="Center"
                   IsVisible="{Binding !Lines.Count}" />
      </Grid>
    </Border>
  </DockPanel>
</UserControl>
