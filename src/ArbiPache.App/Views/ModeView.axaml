<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ArbiPache.App.ViewModels"
             xmlns:settings="using:ArbiPache.Core.Settings"
             x:Class="ArbiPache.App.Views.ModeView"
             x:DataType="vm:ModeViewModel">
  <Grid>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="16">

        <!-- One card per mode: choosing the other one opens the switch dialog -->
        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
          <Button x:Name="CardDev" Classes="kind" Classes.selected="{Binding IsDevelopment}" Padding="20"
                  Command="{Binding SwitchToCommand}" CommandParameter="{x:Static settings:ServerMode.Development}">
            <StackPanel Spacing="6">
              <TextBlock FontSize="16" FontWeight="SemiBold" Text="Development" />
              <TextBlock Classes="dim" FontSize="13" TextWrapping="Wrap"
                         Text="Show every error in the page. Long timeouts and big uploads for imports and debugging. Xdebug on. Files re-read on each request." />
            </StackPanel>
          </Button>
          <Button x:Name="CardProd" Grid.Column="1" Classes="kind prod" Classes.selected="{Binding IsProduction}" Padding="20"
                  Command="{Binding SwitchToCommand}" CommandParameter="{x:Static settings:ServerMode.Production}">
            <StackPanel Spacing="6">
              <TextBlock FontSize="16" FontWeight="SemiBold" Text="Production" />
              <TextBlock Classes="dim" FontSize="13" TextWrapping="Wrap"
                         Text="Hide errors from visitors, log them instead. Short limits stop runaway scripts and slow clients. Shell functions and listings off." />
            </StackPanel>
          </Button>
        </Grid>

        <!-- Both profiles side by side -->
        <Border Classes="card" Padding="0,4">
          <StackPanel>
            <Grid ColumnDefinitions="120,2*,2*,2*" Margin="0,8,0,4">
              <TextBlock Classes="dim" FontSize="12" Margin="16,0,8,0" Text="Where" />
              <TextBlock Grid.Column="1" Classes="dim" FontSize="12" Margin="8,0" Text="Setting" />
              <TextBlock Grid.Column="2" Classes="dim" FontSize="12" Margin="8,0" Text="Development" />
              <TextBlock Grid.Column="3" Classes="dim" FontSize="12" Margin="8,0" Text="Production" />
            </Grid>
            <ItemsControl x:Name="ModeRows" ItemsSource="{Binding Rows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ModeCompareRow">
                  <Border BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0">
                    <Grid ColumnDefinitions="120,2*,2*,2*">
                      <TextBlock Classes="dim" FontSize="13" Margin="16,9,8,9" Text="{Binding Where}" />
                      <TextBlock Grid.Column="1" Classes="mono" FontSize="12" Margin="8,9" TextWrapping="Wrap" Text="{Binding Key}" />
                      <Border Grid.Column="2" Classes="compareCell dev" Classes.on="{Binding DevelopmentActive}">
                        <TextBlock Text="{Binding Development}" />
                      </Border>
                      <Border Grid.Column="3" Classes="compareCell prod" Classes.on="{Binding ProductionActive}">
                        <TextBlock Text="{Binding Production}" />
                      </Border>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <WrapPanel ItemSpacing="10" LineSpacing="10">
          <Button Classes="secondary" Content="Edit Development values" Command="{Binding EditProfileCommand}"
                  CommandParameter="{x:Static settings:ServerMode.Development}" />
          <Button Classes="secondary" Content="Edit Production values" Command="{Binding EditProfileCommand}"
                  CommandParameter="{x:Static settings:ServerMode.Production}" />
          <TextBlock Classes="note" VerticalAlignment="Center" TextWrapping="Wrap"
                     Text="A switch backs up every file it rewrites first, then restarts only what changed." />
        </WrapPanel>
        <TextBlock Classes="error" TextWrapping="Wrap" Text="{Binding Message}" IsVisible="{Binding HasMessage}" />
      </StackPanel>
    </ScrollViewer>

    <!-- Profile editor -->
    <Border Classes="overlay" IsVisible="{Binding HasEditor}">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <!-- A fixed width keeps the value column in line from row to row. -->
        <Border x:Name="ProfileEditor" Classes="dialog" Width="760" Margin="16,24" HorizontalAlignment="Center" VerticalAlignment="Top"
                DataContext="{Binding Editor}" x:DataType="vm:ProfileEditorViewModel">
          <StackPanel Spacing="16">
            <StackPanel Spacing="4">
              <TextBlock Classes="h1" Text="{Binding Title}" />
              <TextBlock Classes="para" Text="{Binding Note}" />
            </StackPanel>
            <StackPanel>
              <Grid ColumnDefinitions="90,2*,2*,1.5*" ColumnSpacing="10" Margin="0,0,0,6">
                <TextBlock Classes="dim" FontSize="12" Text="Where" />
                <TextBlock Grid.Column="1" Classes="dim" FontSize="12" Text="Setting" />
                <TextBlock Grid.Column="2" Classes="dim" FontSize="12" Text="Value" />
                <TextBlock Grid.Column="3" Classes="dim" FontSize="12" Text="Built-in" />
              </Grid>
              <ItemsControl x:Name="ProfileValues" ItemsSource="{Binding Items}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Spacing="6" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ProfileValueItem">
                    <Grid ColumnDefinitions="90,2*,2*,1.5*" ColumnSpacing="10">
                      <TextBlock Classes="dim" FontSize="13" VerticalAlignment="Center" Text="{Binding Where}" />
                      <TextBlock Grid.Column="1" Classes="mono" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding Key}" />
                      <TextBox Grid.Column="2" Classes="field" FontFamily="{StaticResource MonoFont}" FontSize="12" Text="{Binding Value}" />
                      <TextBlock Grid.Column="3" Classes="mono dim" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding BuiltInText}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <StackPanel Spacing="6">
              <CheckBox Content="Load Xdebug" IsChecked="{Binding Xdebug}" />
              <CheckBox Content="Send security headers (nosniff, SAMEORIGIN, Referrer-Policy)" IsChecked="{Binding SecurityHeaders}" />
              <CheckBox Content="List folders without an index page in htdocs (Options Indexes)" IsChecked="{Binding DirectoryListing}" />
            </StackPanel>
            <TextBlock Classes="error" TextWrapping="Wrap" Text="{Binding Message}" IsVisible="{Binding HasMessage}" />
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="10">
                <Button Classes="secondary" Content="Cancel" Command="{Binding CancelCommand}" />
                <Button Classes="primary" Content="{Binding SaveLabel}" Command="{Binding SaveCommand}" />
              </StackPanel>
              <Button Classes="ghost" HorizontalAlignment="Left" Content="Use built-in values" Command="{Binding ResetCommand}" />
            </DockPanel>
          </StackPanel>
        </Border>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
