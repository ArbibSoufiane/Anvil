# Generated by ArbiPache. Site: {{ title }}
{{~ for v in vhosts ~}}
<VirtualHost *:{{ v.port }}>
    ServerName {{ server_name }}
{{~ if aliases ~}}
    ServerAlias {{ aliases }}
{{~ end ~}}
    ErrorLog "{{ error_log }}"
    CustomLog "{{ if v.ssl }}{{ ssl_access_log }}{{ else }}{{ access_log }}{{ end }}" combined
{{~ if v.ssl ~}}
    SSLEngine on
    SSLCertificateFile "{{ cert.cert }}"
    SSLCertificateKeyFile "{{ cert.key }}"
{{~ if cert.chain ~}}
    SSLCertificateChainFile "{{ cert.chain }}"
{{~ end ~}}
{{~ end ~}}
{{~ if v.redirect ~}}
    RedirectMatch 301 ^/(?!\.well-known/acme-challenge/)(.*)$ {{ redirect }}$1
{{~ else ~}}
{{~ if lb ~}}
{{ lb }}
{{~ end ~}}
{{~ if proxy ~}}
{{~ for m in mounts ~}}
{{ m }}
{{~ end ~}}
{{ proxy }}
{{~ else ~}}
    DocumentRoot "{{ root }}"
    <Directory "{{ root }}">
        Options {{ options }}
        AllowOverride All
        DirectoryIndex {{ index }}
{{ rules }}
{{~ if php ~}}
{{ php }}
{{~ end ~}}
    </Directory>
{{~ for m in mounts ~}}
{{ m }}
{{~ end ~}}
{{~ end ~}}
{{~ end ~}}
</VirtualHost>
{{~ end ~}}
