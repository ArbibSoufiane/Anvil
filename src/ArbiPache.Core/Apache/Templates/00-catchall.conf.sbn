# Generated by ArbiPache. First virtual host: answers requests for host names no site claims.
<VirtualHost *:{{ port }}>
    ServerName arbipache-catchall.invalid
{{~ if deny_all ~}}
    ErrorDocument 403 " "
    <Location "/">
        Require all denied
    </Location>
{{~ else ~}}
    DocumentRoot "{{ htdocs }}"
    <Directory "{{ htdocs }}">
        Options {{ options }}
        AllowOverride All
        Require {{ require }}
    </Directory>
{{~ end ~}}
</VirtualHost>
