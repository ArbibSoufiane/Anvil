# Generated by ArbiPache {{ version }}. Changes here are overwritten.
# Put your own settings in data/apache/httpd.conf.
{{~ for m in modules ~}}
LoadModule {{ m }}_module modules/mod_{{ m }}.so
{{~ end ~}}
{{~ for p in listen ~}}
Listen {{ p }}
{{~ end ~}}

ServerName localhost
PidFile "{{ pid_file }}"
ErrorLog "{{ error_log }}"

<IfModule mpm_winnt_module>
    ThreadsPerChild {{ threads_per_child }}
    MaxConnectionsPerChild {{ max_connections_per_child }}
</IfModule>
KeepAlive On
KeepAliveTimeout {{ keep_alive_timeout }}
MaxKeepAliveRequests 100

<IfModule ssl_module>
    SSLProtocol -all +TLSv1.2 +TLSv1.3
    SSLCipherSuite HIGH:!aNULL:!MD5
    SSLHonorCipherOrder on
    SSLSessionCache "shmcb:{{ ssl_session_cache }}(512000)"
    SSLSessionCacheTimeout 300
</IfModule>
{{~ if http2 ~}}
<IfModule http2_module>
    Protocols h2 http/1.1
</IfModule>
{{~ end ~}}

Include "{{ mode_conf }}"
IncludeOptional "{{ vhosts }}/*.conf"
