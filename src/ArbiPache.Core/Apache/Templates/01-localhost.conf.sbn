# Generated by ArbiPache. htdocs on this PC: http://localhost/<folder>
<VirtualHost *:{{ port }}>
    ServerName localhost
    ServerAlias 127.0.0.1 [::1]
    DocumentRoot "{{ htdocs }}"
    <Directory "{{ htdocs }}">
        Options {{ options }}
        AllowOverride All
        Require local
    </Directory>
{{~ if php_handler ~}}
{{ php_handler }}
{{~ end ~}}
</VirtualHost>
