# Generated by ArbiPache. One FastCGI listener per PHP version, served by its php-cgi workers.
{{~ if pools.size == 0 ~}}
# No PHP version is installed and in use.
{{~ else ~}}
# Windows php-cgi gets SCRIPT_FILENAME as "/C:/..."; drop the leading slash.
ProxyFCGIBackendType GENERIC
ProxyFCGISetEnvIf "reqenv('SCRIPT_FILENAME') =~ m#^/([A-Za-z]:/.*)$#" SCRIPT_FILENAME "$1"
{{~ for p in pools ~}}

# PHP {{ p.version }}
<Proxy "fcgi://127.0.0.1:{{ p.port }}/">
    ProxySet timeout={{ timeout }} retry=0
</Proxy>
{{~ end ~}}
{{~ end ~}}
