<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>ArbiPache.Core</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The Agent pipe uses SystemTextJsonFormatter only; PolyType shapes serve formatters we do not use. -->
    <NoWarn>$(NoWarn);StreamJsonRpc0008</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
    <PackageReference Include="Scriban" />
    <PackageReference Include="StreamJsonRpc" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>
  <ItemGroup>
    <AdditionalFiles Include="Processes\NativeMethods.txt" />
    <EmbeddedResource Include="Apache\Templates\*.sbn" LogicalName="ArbiPache.Templates.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ArbiPache.Core.Tests" />
  </ItemGroup>
</Project>
