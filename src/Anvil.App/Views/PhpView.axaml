<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Anvil.App.ViewModels"
             xmlns:v="using:Anvil.App.Views"
             x:Class="Anvil.App.Views.PhpView"
             x:DataType="vm:PhpViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="16">

      <v:UpdatesBanner DataContext="{Binding Updates}" IsVisible="{Binding IsShown}" />

      <Border Classes="card">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="2*,1.4*,*,1.4*,*,200" Margin="8,0">
            <TextBlock Classes="dt" Text="Version" />
            <TextBlock Classes="dt" Grid.Column="1" Text="Build" />
            <TextBlock Classes="dt" Grid.Column="2" Text="Pool" />
            <TextBlock Classes="dt" Grid.Column="3" Text="Used by" />
            <TextBlock Classes="dt" Grid.Column="4" Text="Status" />
            <TextBlock Classes="dt" Grid.Column="5" Text="Files" HorizontalAlignment="Right" />
          </Grid>
          <ItemsControl x:Name="PhpVersions" ItemsSource="{Binding Versions}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PhpVersionRow">
                <Border Classes="row" Padding="0,4">
                  <Grid ColumnDefinitions="*,200">
                    <Button Classes="rowSelect" Classes.selected="{Binding IsSelected}" Command="{Binding SelectCommand}">
                      <Grid ColumnDefinitions="2*,1.4*,*,1.4*,*">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <TextBlock Classes="dd" FontWeight="Medium" VerticalAlignment="Center" Text="{Binding Title}" />
                          <Border Classes="tag" IsVisible="{Binding Info.IsDefault}">
                            <TextBlock Text="Default" />
                          </Border>
                          <Border Classes="tag eol" IsVisible="{Binding Info.EndOfLife}">
                            <TextBlock Text="End of life" />
                          </Border>
                        </StackPanel>
                        <TextBlock Classes="dd" Grid.Column="1" VerticalAlignment="Center" Text="{Binding Build}" />
                        <TextBlock Classes="dd" Grid.Column="2" VerticalAlignment="Center" Text="{Binding PoolText}" />
                        <TextBlock Classes="dd" Grid.Column="3" VerticalAlignment="Center" Text="{Binding UsedBy}" TextTrimming="CharacterEllipsis" />
                        <Border Classes="pill" Classes.ok="{Binding IsRunning}" Grid.Column="4" HorizontalAlignment="Left">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse />
                            <TextBlock Text="{Binding StatusText}" />
                          </StackPanel>
                        </Border>
                      </Grid>
                    </Button>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                      <Button Classes="ghost" Content="php.ini"
                              Command="{Binding $parent[UserControl].((vm:PhpViewModel)DataContext).OpenIniCommand}" CommandParameter="{Binding}" />
                      <Button Classes="ghost" Content="ext folder"
                              Command="{Binding $parent[UserControl].((vm:PhpViewModel)DataContext).OpenExtFolderCommand}" CommandParameter="{Binding}" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Classes="note" Margin="8,4,8,0" IsVisible="{Binding !HasVersions}"
                     Text="No PHP version is installed yet. Pick one under Install another version and press Download." />
          <TextBlock Classes="note" Margin="8,4,8,0" IsVisible="{Binding HasVersions}"
                     Text="Click a version to edit its pool and extensions. Downloads are SHA-256 verified." />
        </StackPanel>
      </Border>

      <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
        <Border Classes="card" IsVisible="{Binding HasSelection}">
          <StackPanel Spacing="14">
            <TextBlock Classes="h2" Text="{Binding PoolTitle}" />
            <TextBlock Classes="para"
                       Text="PHP-FPM is Linux-only. Anvil runs the same model natively: php-cgi workers share one socket behind Apache's proxy_fcgi, are restarted if one crashes and recycled after N requests." />
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="12">
              <StackPanel Spacing="4">
                <TextBlock Classes="fieldLabel" Text="Workers" />
                <TextBox Classes="field" x:Name="Workers" Text="{Binding Workers}" />
                <TextBlock Classes="note" Text="{Binding WorkersHint}" />
              </StackPanel>
              <StackPanel Spacing="4" Grid.Column="1">
                <TextBlock Classes="fieldLabel" Text="Recycle after (requests)" />
                <TextBox Classes="field" Text="{Binding MaxRequests}" />
              </StackPanel>
              <StackPanel Spacing="4" Grid.Row="1">
                <TextBlock Classes="fieldLabel" Text="Listens on" />
                <TextBox Classes="field" Text="{Binding PortText}" IsReadOnly="True" />
              </StackPanel>
              <StackPanel Spacing="4" Grid.Row="1" Grid.Column="1">
                <TextBlock Classes="fieldLabel" Text="Max execution time (s)" />
                <TextBox Classes="field" Text="{Binding MaxExecutionTime}" IsReadOnly="True" />
                <TextBlock Classes="note" Text="{Binding MaxExecutionTimeHint}" />
              </StackPanel>
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Button Classes="primary" Content="Apply" Command="{Binding ApplyPoolCommand}" />
              <Button Classes="secondary" Content="Make default" Command="{Binding MakeDefaultCommand}" />
            </StackPanel>
            <TextBlock Classes="result" Classes.ok="{Binding ResultOk}" Text="{Binding ResultText}"
                       IsVisible="{Binding ResultText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
        </Border>

        <Border Classes="card" Grid.Column="1">
          <StackPanel Spacing="12">
            <TextBlock Classes="h2" Text="{Binding ExtensionsTitle}" />
            <ItemsControl x:Name="Extensions" ItemsSource="{Binding Extensions}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel ItemSpacing="8" LineSpacing="8" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ExtensionChip">
                  <Button Classes="chip" Classes.on="{Binding IsOn}" Content="{Binding Name}" Command="{Binding ToggleCommand}"
                          ToolTip.Tip="{Binding Hint}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Classes="note"
                       Text="A change edits php.ini and restarts this version's workers one at a time." />
            <Button Classes="ghost" Content="Get Xdebug" Command="{Binding GetXdebugCommand}" IsVisible="{Binding CanGetXdebug}" />
            <TextBlock Classes="result" Text="{Binding ExtensionsMessage}"
                       IsVisible="{Binding ExtensionsMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <StackPanel Spacing="4" Margin="0,8,0,0">
              <TextBlock Classes="fieldLabel" Text="Install another version" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <ComboBox MinWidth="260" ItemsSource="{Binding InstallChoices}" SelectedItem="{Binding SelectedInstall}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:InstallChoice">
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Classes="secondary" Content="Download" Command="{Binding InstallCommand}" />
              </StackPanel>
            </StackPanel>
            <TextBlock Classes="result" Text="{Binding VersionsMessage}"
                       IsVisible="{Binding VersionsMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
