<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Anvil.App.ViewModels"
             xmlns:v="using:Anvil.App.Views"
             x:Class="Anvil.App.Views.PhpView"
             x:DataType="vm:PhpViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="16">

      <v:UpdatesBanner DataContext="{Binding Updates}" IsVisible="{Binding IsShown}" />

      <Border Classes="card">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="2*,1.4*,*,1.4*,*,200" Margin="8,0">
            <TextBlock Classes="dt" Text="Version" />
            <TextBlock Classes="dt" Grid.Column="1" Text="Build" />
            <TextBlock Classes="dt" Grid.Column="2" Text="Pool" />
            <TextBlock Classes="dt" Grid.Column="3" Text="Used by" />
            <TextBlock Classes="dt" Grid.Column="4" Text="Status" />
            <TextBlock Classes="dt" Grid.Column="5" Text="Files" HorizontalAlignment="Right" />
          </Grid>
          <ItemsControl x:Name="PhpVersions" ItemsSource="{Binding Versions}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PhpVersionRow">
                <Border Classes="row" Padding="0,4">
                  <Grid ColumnDefinitions="*,200">
                    <Button Classes="rowSelect" Classes.selected="{Binding IsSelected}" Command="{Binding SelectCommand}">
                      <Grid ColumnDefinitions="2*,1.4*,*,1.4*,*">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <TextBlock Classes="dd" FontWeight="Medium" VerticalAlignment="Center" Text="{Binding Title}" />
                          <Border Classes="tag" IsVisible="{Binding Info.IsDefault}">
                            <TextBlock Text="Default" />
                          </Border>
                          <Border Classes="tag" IsVisible="{Binding Info.Linked}" ToolTip.Tip="{Binding Info.Folder}">
                            <TextBlock Text="Linked" />
                          </Border>
                          <Border Classes="tag eol" IsVisible="{Binding Info.EndOfLife}">
                            <TextBlock Text="End of life" />
                          </Border>
                        </StackPanel>
                        <TextBlock Classes="dd" Grid.Column="1" VerticalAlignment="Center" Text="{Binding Build}" />
                        <TextBlock Classes="dd" Grid.Column="2" VerticalAlignment="Center" Text="{Binding PoolText}" />
                        <TextBlock Classes="dd" Grid.Column="3" VerticalAlignment="Center" Text="{Binding UsedBy}" TextTrimming="CharacterEllipsis" />
                        <Border Classes="pill" Classes.ok="{Binding IsRunning}" Grid.Column="4" HorizontalAlignment="Left">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse />
                            <TextBlock Text="{Binding StatusText}" />
                          </StackPanel>
                        </Border>
                      </Grid>
                    </Button>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                      <Button Classes="ghost" Content="php.ini"
                              Command="{Binding $parent[UserControl].((vm:PhpViewModel)DataContext).OpenIniCommand}" CommandParameter="{Binding}" />
                      <Button Classes="ghost" Content="ext folder"
                              Command="{Binding $parent[UserControl].((vm:PhpViewModel)DataContext).OpenExtFolderCommand}" CommandParameter="{Binding}" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Classes="note" Margin="8,4,8,0" IsVisible="{Binding !HasVersions}"
                     Text="No PHP version is installed yet. Pick one under Install another version and press Download." />
          <TextBlock Classes="note" Margin="8,4,8,0" IsVisible="{Binding HasVersions}"
                     Text="Click a version to edit its pool and extensions. Downloads are SHA-256 verified." />
        </StackPanel>
      </Border>

      <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
        <Border Classes="card" IsVisible="{Binding HasSelection}">
          <StackPanel Spacing="14">
            <TextBlock Classes="h2" Text="{Binding PoolTitle}" />
            <TextBlock Classes="para"
                       Text="PHP-FPM is Linux-only. Anvil runs the same model natively: php-cgi workers share one socket behind Apache's proxy_fcgi, are restarted if one crashes and recycled after N requests." />
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="12">
              <StackPanel Spacing="4">
                <TextBlock Classes="fieldLabel" Text="Workers" />
                <TextBox Classes="field" x:Name="Workers" Text="{Binding Workers}" />
                <TextBlock Classes="note" Text="{Binding WorkersHint}" />
              </StackPanel>
              <StackPanel Spacing="4" Grid.Column="1">
                <TextBlock Classes="fieldLabel" Text="Recycle after (requests)" />
                <TextBox Classes="field" Text="{Binding MaxRequests}" />
              </StackPanel>
              <StackPanel Spacing="4" Grid.Row="1" Grid.ColumnSpan="2">
                <TextBlock Classes="fieldLabel" Text="Listens on" />
                <TextBox Classes="field" x:Name="ListensOn" Text="{Binding PortText}" IsReadOnly="True" />
              </StackPanel>
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Button Classes="primary" Content="Apply" Command="{Binding ApplyPoolCommand}" />
              <Button Classes="secondary" Content="Make default" Command="{Binding MakeDefaultCommand}" />
              <Button Classes="ghost" Content="Remove from Anvil" Command="{Binding UnlinkCommand}" IsVisible="{Binding CanUnlink}"
                      ToolTip.Tip="Anvil forgets this version. Its folder stays as it is." />
            </StackPanel>
            <TextBlock Classes="result" Classes.ok="{Binding ResultOk}" Text="{Binding ResultText}"
                       IsVisible="{Binding ResultText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
        </Border>

        <Border Classes="card" Grid.Column="1">
          <StackPanel Spacing="12">
            <TextBlock Classes="h2" Text="{Binding ExtensionsTitle}" />
            <StackPanel Spacing="8" IsVisible="{Binding HasSelection}">
              <TextBlock Classes="fieldLabel" Text="Debugging and cache" />
              <WrapPanel ItemSpacing="8" LineSpacing="8">
                <Button Classes="chip" x:Name="XdebugSwitch" Classes.on="{Binding XdebugChip.IsOn, FallbackValue=False}" Content="Xdebug"
                        Command="{Binding XdebugChip.ToggleCommand, FallbackValue={x:Null}}" IsVisible="{Binding HasXdebug}"
                        ToolTip.Tip="{Binding XdebugChip.Hint, FallbackValue={x:Null}}" />
                <Button Classes="chip" x:Name="OpcacheSwitch" Classes.on="{Binding OpcacheChip.IsOn, FallbackValue=False}" Content="OPcache"
                        Command="{Binding OpcacheChip.ToggleCommand, FallbackValue={x:Null}}" IsVisible="{Binding HasOpcache}"
                        ToolTip.Tip="{Binding OpcacheChip.Hint, FallbackValue={x:Null}}" />
                <Button Classes="ghost" Content="Get Xdebug" Command="{Binding GetXdebugCommand}" IsVisible="{Binding CanGetXdebug}" />
              </WrapPanel>
              <TextBlock Classes="note" TextWrapping="Wrap"
                         Text="Highlighted means on. Xdebug starts on a trigger: XDEBUG_TRIGGER in a request, or a browser extension. A PHP from pvm uses the Xdebug in its own ext folder." />
            </StackPanel>
            <TextBlock Classes="fieldLabel" Text="Extensions" IsVisible="{Binding HasSelection}" />
            <ItemsControl x:Name="Extensions" ItemsSource="{Binding Extensions}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel ItemSpacing="8" LineSpacing="8" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ExtensionChip">
                  <Button Classes="chip" Classes.on="{Binding IsOn}" Content="{Binding Name}" Command="{Binding ToggleCommand}"
                          ToolTip.Tip="{Binding Hint}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Classes="note"
                       Text="A change edits php.ini and restarts this version's workers one at a time." />
            <TextBlock Classes="result" Text="{Binding ExtensionsMessage}"
                       IsVisible="{Binding ExtensionsMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <StackPanel Spacing="4" Margin="0,8,0,0">
              <TextBlock Classes="fieldLabel" Text="Install another version" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <ComboBox MinWidth="260" ItemsSource="{Binding InstallChoices}" SelectedItem="{Binding SelectedInstall}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:InstallChoice">
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Classes="secondary" Content="Download" Command="{Binding InstallCommand}" />
              </StackPanel>
            </StackPanel>

            <StackPanel Spacing="6" Margin="0,8,0,0">
              <TextBlock Classes="fieldLabel" Text="Use a PHP you already have" />
              <TextBlock Classes="note" IsVisible="{Binding HasPvmChoices}" Text="Found in pvm:" />
              <ItemsControl x:Name="PvmChoices" ItemsSource="{Binding PvmChoices}" IsVisible="{Binding HasPvmChoices}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:PvmChoice">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                      <TextBlock Classes="dd" VerticalAlignment="Center" Text="{Binding Label}" ToolTip.Tip="{Binding Found.Folder}" />
                      <Button Classes="ghost" Grid.Column="1" Content="Add" Command="{Binding AddCommand}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Classes="ghost" Content="Add a PHP folder…" Command="{Binding AddFolderCommand}" />
              <TextBlock Classes="note"
                         Text="Anvil uses the folder where it is, gives it its own php.ini, and never changes or deletes it." />
            </StackPanel>
            <TextBlock Classes="result" Text="{Binding VersionsMessage}"
                       IsVisible="{Binding VersionsMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
        </Border>
      </Grid>

      <!-- The limits most projects change in php.ini -->
      <Border Classes="card" x:Name="PhpIni" IsVisible="{Binding HasSelection}">
        <StackPanel Spacing="14">
          <DockPanel>
            <Button Classes="ghost" DockPanel.Dock="Right" Content="Open php.ini" VerticalAlignment="Center"
                    Command="{Binding OpenIniCommand}" CommandParameter="{Binding Selected}" />
            <TextBlock Classes="h2" Text="{Binding IniTitle}" VerticalAlignment="Center" />
          </DockPanel>
          <ItemsControl x:Name="IniFields" ItemsSource="{Binding IniFields}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="3" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PhpIniField">
                <StackPanel Spacing="4" Margin="0,0,16,12">
                  <TextBlock Classes="fieldLabel" Text="{Binding Label}" />
                  <TextBox Classes="field mono" Text="{Binding Value}" PlaceholderText="{Binding Setting.PhpDefault}" ToolTip.Tip="{Binding Key}" />
                  <TextBlock Classes="note" Text="{Binding Key}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Button Classes="primary" Content="Save and restart pool" Command="{Binding SaveIniCommand}" />
            <TextBlock Classes="note" VerticalAlignment="Center" TextWrapping="Wrap"
                       Text="Sizes take K, M or G, such as 256M. An empty box leaves the setting to PHP's default, shown greyed." />
          </StackPanel>
          <TextBlock Classes="result" Classes.ok="{Binding IniOk}" Text="{Binding IniMessage}" TextWrapping="Wrap"
                     IsVisible="{Binding IniMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
