<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Anvil.App.ViewModels"
             x:Class="Anvil.App.Views.DatabaseView"
             x:DataType="vm:DatabaseViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="16">

      <!-- MariaDB and MySQL servers the user installed themselves -->
      <StackPanel Spacing="12" DataContext="{Binding Linked}" x:DataType="vm:LinkedDatabasesViewModel">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Classes="ghost" Content="Refresh all" Command="{Binding RefreshAllCommand}" IsVisible="{Binding HasServers}"
                    ToolTip.Tip="Checks that each server still runs and lets Anvil log in" />
            <Button Classes="secondary" Content="Link a server…" Command="{Binding ChooseFolderCommand}" />
          </StackPanel>
          <StackPanel Spacing="2" VerticalAlignment="Center">
            <TextBlock Classes="h2" Text="Your servers" />
            <TextBlock Classes="note" TextWrapping="Wrap"
                       Text="MariaDB or MySQL you installed yourself. Linking a Windows service asks Windows once; after that Start and Stop do not ask again." />
          </StackPanel>
        </DockPanel>

        <Border Classes="card" IsVisible="{Binding IsLinking}">
          <StackPanel Spacing="12">
            <TextBlock Classes="h2" Text="Link a server" />
            <StackPanel Spacing="4">
              <TextBlock Classes="fieldLabel" Text="Bin folder" />
              <TextBox Classes="field mono" Text="{Binding LinkFolder}" IsReadOnly="True" />
            </StackPanel>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
              <StackPanel Spacing="4">
                <TextBlock Classes="fieldLabel" Text="User" />
                <TextBox Classes="field" Text="{Binding LinkUser}" />
              </StackPanel>
              <StackPanel Spacing="4" Grid.Column="1">
                <TextBlock Classes="fieldLabel" Text="Password" />
                <TextBox Classes="field" Text="{Binding LinkPassword}" PasswordChar="•" />
              </StackPanel>
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Button Classes="primary" Content="Link" Command="{Binding LinkCommand}" />
              <Button Classes="ghost" Content="Cancel" Command="{Binding CancelLinkCommand}" />
            </StackPanel>
            <TextBlock Classes="note" TextWrapping="Wrap"
                       Text="Anvil logs in with this account to check the server and to back it up. The password is kept encrypted on this PC." />
          </StackPanel>
        </Border>

        <TextBlock Classes="result" Classes.ok="{Binding MessageOk}" Text="{Binding Message}" TextWrapping="Wrap"
                   IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <Border Classes="card" Padding="0,8" IsVisible="{Binding HasServers}">
          <ItemsControl x:Name="LinkedServers" ItemsSource="{Binding Servers}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:LinkedDbRow">
                <Border Classes="row" Padding="16,10">
                  <Grid ColumnDefinitions="*,90,Auto" ColumnSpacing="12">
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                      <TextBlock FontWeight="Medium" Text="{Binding Title}" />
                      <TextBlock Classes="note" Text="{Binding Detail}" />
                      <TextBlock Classes="mono dim" FontSize="12" Text="{Binding Info.BinDir}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="result" Classes.ok="{Binding CheckOk}" Text="{Binding CheckText}" TextWrapping="Wrap"
                                 IsVisible="{Binding HasCheck}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding StatusText}" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <Button Classes="ghost" Content="Refresh" Command="{Binding RefreshCommand}"
                              ToolTip.Tip="Checks that the server still runs and lets Anvil log in" />
                      <Button Classes="secondary" Content="Start" Command="{Binding StartCommand}" IsVisible="{Binding !IsRunning}" />
                      <Button Classes="secondary" Content="Stop" Command="{Binding StopCommand}" IsVisible="{Binding IsRunning}" />
                      <TextBox Classes="field" Width="80" Text="{Binding PortText}" ToolTip.Tip="Port" />
                      <Button Classes="secondary" Content="Apply port" Command="{Binding ApplyPortCommand}" />
                      <Button Classes="secondary" Content="Back up" Command="{Binding BackupCommand}" IsEnabled="{Binding IsRunning}" />
                      <Button Classes="ghost" Content="Unlink" Command="{Binding UnlinkCommand}" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>
        <TextBlock Classes="note" x:Name="NoServers" IsVisible="{Binding !HasServers}"
                   Text="No server is linked yet. Install MariaDB or MySQL as the guide below shows, then link it." />
      </StackPanel>

      <!-- Where to get a server, and how to link it -->
      <Border Classes="card" x:Name="DbGuide">
        <StackPanel Spacing="12">
          <TextBlock Classes="h2" Text="Getting a database server" />
          <TextBlock Classes="para" TextWrapping="Wrap"
                     Text="Anvil does not download databases. Install MariaDB or MySQL yourself, then link it here to start, stop, back it up and change its port from Anvil." />
          <ItemsControl x:Name="DbSteps" ItemsSource="{x:Static vm:DatabaseViewModel.Steps}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="6" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <DockPanel>
                  <Ellipse Width="4" Height="4" Fill="{StaticResource TextDimBrush}" Margin="2,7,10,0" VerticalAlignment="Top" DockPanel.Dock="Left" />
                  <TextBlock Classes="para" Text="{Binding}" TextWrapping="Wrap" />
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <ItemsControl x:Name="DbDownloads" ItemsSource="{x:Static vm:DatabaseViewModel.Downloads}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="8" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:DbDownload">
                <Border Classes="row">
                  <DockPanel>
                    <Button Classes="secondary" Content="Open download page" DockPanel.Dock="Right" VerticalAlignment="Center"
                            Command="{Binding $parent[UserControl].((vm:DatabaseViewModel)DataContext).OpenDownloadCommand}"
                            CommandParameter="{Binding}" />
                    <StackPanel Spacing="2">
                      <TextBlock FontWeight="Medium" Text="{Binding Name}" />
                      <TextBlock Classes="url" Text="{Binding Url}" />
                      <TextBlock Classes="note" Text="{Binding Note}" TextWrapping="Wrap" />
                    </StackPanel>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
