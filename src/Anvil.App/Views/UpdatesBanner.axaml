<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Anvil.App.ViewModels"
             x:Class="Anvil.App.Views.UpdatesBanner"
             x:DataType="vm:UpdatesPanel">
  <StackPanel Spacing="8">
    <Border Classes="card" IsVisible="{Binding HasRows}">
      <StackPanel Spacing="12">
        <TextBlock Classes="h2" Text="Update available" />
        <ItemsControl ItemsSource="{Binding Rows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:UpdateRow">
              <Border Classes="row">
                <DockPanel>
                  <Button DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0"
                          Content="Update" Command="{Binding UpdateCommand}" />
                  <StackPanel Spacing="2">
                    <TextBlock Classes="dd" FontWeight="Medium" Text="{Binding Title}" />
                    <TextBlock Classes="note" TextWrapping="Wrap" Text="{Binding Note}" />
                  </StackPanel>
                </DockPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
    <TextBlock Classes="result" Classes.ok="{Binding MessageOk}" Text="{Binding Message}"
               IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
  </StackPanel>
</UserControl>
