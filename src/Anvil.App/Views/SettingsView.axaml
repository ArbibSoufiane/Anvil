<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Anvil.App.ViewModels"
             x:Class="Anvil.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="16">
      <TextBlock x:Name="SettingsMessage" Classes="result" Classes.ok="{Binding MessageOk}" Text="{Binding Message}"
                 IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

      <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
        <StackPanel Spacing="16">
          <Border Classes="card">
            <StackPanel Spacing="12">
              <TextBlock Classes="h2" Text="General" />
              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12">
                <TextBlock Classes="dd" VerticalAlignment="Center" Text="Run Apache when Windows starts" FontWeight="Medium" />
                <ToggleSwitch x:Name="RunApacheAtLogin" Grid.Column="1" Grid.RowSpan="2" OnContent="" OffContent="" VerticalAlignment="Center"
                              IsChecked="{Binding RunApacheAtLogin}" Command="{Binding ApplyRunApacheAtLoginCommand}" />
                <TextBlock Grid.Row="1" Classes="note" TextWrapping="Wrap"
                           Text="When you log in, Anvil opens in the tray and starts Apache and PHP. It is not a Windows service, so nothing runs before you log in." />
              </Grid>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="dd" VerticalAlignment="Center" Text="Start services when Anvil opens" />
                <ToggleSwitch Grid.Column="1" OnContent="" OffContent="" IsChecked="{Binding StartServicesOnLaunch}" Command="{Binding ApplyGeneralCommand}" />
              </Grid>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="dd" VerticalAlignment="Center" Text="Start Anvil with Windows" />
                <ToggleSwitch x:Name="StartWithWindows" Grid.Column="1" OnContent="" OffContent="" IsChecked="{Binding StartWithWindows}"
                              Command="{Binding ApplyGeneralCommand}" />
              </Grid>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="dd" VerticalAlignment="Center" Text="Closing the window keeps it in the tray" />
                <ToggleSwitch Grid.Column="1" OnContent="" OffContent="" IsChecked="{Binding CloseToTray}" Command="{Binding ApplyGeneralCommand}" />
              </Grid>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="dd" VerticalAlignment="Center" Text="Appearance" />
                <Border Grid.Column="1" Classes="segs" x:Name="ThemeChoice">
                  <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button Classes="seg" Classes.selected="{Binding IsDarkTheme}" Content="Dark" Command="{Binding UseThemeCommand}" CommandParameter="dark" />
                    <Button Classes="seg" Classes.selected="{Binding IsLightTheme}" Content="Light" Command="{Binding UseThemeCommand}" CommandParameter="light" />
                    <Button Classes="seg" Classes.selected="{Binding IsSystemTheme}" Content="Windows" Command="{Binding UseThemeCommand}" CommandParameter="system"
                            ToolTip.Tip="Follows the app mode chosen in Windows' colour settings" />
                  </StackPanel>
                </Border>
              </Grid>
              <StackPanel Spacing="4">
                <TextBlock Classes="fieldLabel" Text="Open config files with" />
                <TextBlock Classes="dd mono" Text="{Binding EditorText}" TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Classes="secondary" Content="Choose program…" Command="{Binding ChooseEditorCommand}" />
                  <Button Classes="ghost" Content="Automatic" Command="{Binding UseAutomaticEditorCommand}" />
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Classes="card" x:Name="NetworkSharing">
            <StackPanel Spacing="12">
              <TextBlock Classes="h2" Text="Network sharing" />
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="dd" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding NetworkLabel}" />
                <ToggleSwitch Grid.Column="1" OnContent="" OffContent="" IsChecked="{Binding HtdocsOnNetwork}" Command="{Binding ApplyNetworkCommand}" />
              </Grid>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="4">
                  <TextBlock Classes="fieldLabel" Text="Network domain" />
                  <TextBox x:Name="NetworkDomain" Classes="field" Text="{Binding NetworkDomain}" PlaceholderText="&lt;computer name&gt;.internal" />
                </StackPanel>
                <Button Grid.Column="1" Classes="secondary" VerticalAlignment="Bottom" Content="Save" Command="{Binding SaveNetworkDomainCommand}" />
              </Grid>
              <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="4">
                <TextBlock Classes="dt" Text="Name service" />
                <TextBlock x:Name="NameServiceStatus" Grid.Column="1" Classes="dd" TextWrapping="Wrap" Text="{Binding NameServiceStatus}" />
                <TextBlock Grid.Row="1" Classes="dt" Text="This PC" />
                <TextBlock x:Name="ThisPcAddress" Grid.Row="1" Grid.Column="1" Classes="dd mono" Text="{Binding ThisPcAddress}" />
              </Grid>
              <ItemsControl x:Name="NetworkProblems" ItemsSource="{Binding NetworkProblems}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <TextBlock Classes="error" TextWrapping="Wrap" Text="{Binding}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <StackPanel Spacing="8" IsVisible="{Binding HasCommands}">
                <TextBlock Classes="fieldLabel" Text="Windows" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <TextBlock x:Name="WindowsCommand" Classes="mono" TextWrapping="Wrap" VerticalAlignment="Center" Text="{Binding WindowsCommand}" />
                  <Button x:Name="CopyWindowsCommand" Grid.Column="1" Classes="secondary" Content="Copy" Command="{Binding CopyWindowsCommandCommand}" />
                </Grid>
                <TextBlock Classes="note" TextWrapping="Wrap" Text="Your colleague runs this once in an administrator PowerShell window." />
                <TextBlock Classes="fieldLabel" Text="Mac" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <TextBlock x:Name="MacCommand" Classes="mono" TextWrapping="Wrap" VerticalAlignment="Center" Text="{Binding MacCommand}" />
                  <Button x:Name="CopyMacCommand" Grid.Column="1" Classes="secondary" Content="Copy" Command="{Binding CopyMacCommandCommand}" />
                </Grid>
                <TextBlock Classes="note" TextWrapping="Wrap"
                           Text="If this PC's address changes, they run it again with the new one. A DHCP reservation in your router keeps the address fixed." />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Classes="card">
            <StackPanel Spacing="12">
              <TextBlock Classes="h2" Text="Ports" />
              <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="4">
                  <TextBlock Classes="fieldLabel" Text="HTTP port" />
                  <TextBox x:Name="HttpPort" Classes="field" Text="{Binding HttpPortText}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                  <TextBlock Classes="fieldLabel" Text="HTTPS port" />
                  <TextBox Classes="field" Text="{Binding HttpsPortText}" />
                </StackPanel>
                <Button Grid.Column="2" Classes="secondary" VerticalAlignment="Bottom" Content="Apply" Command="{Binding ApplyPortsCommand}" />
              </Grid>
              <TextBlock Classes="note" TextWrapping="Wrap"
                         Text="Servers you linked on the Database page keep their own port; change it there." />
              <TextBlock Classes="error" Text="{Binding PortsError}" IsVisible="{Binding PortsError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel Grid.Column="1" Spacing="16">
          <Border Classes="card">
            <StackPanel Spacing="12">
              <TextBlock Classes="h2" Text="Folders" />
              <Grid ColumnDefinitions="80,*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="10">
                <TextBlock Classes="dt" VerticalAlignment="Center" Text="App" />
                <TextBlock Grid.Column="1" Classes="dd mono" VerticalAlignment="Center" Text="{Binding AppFolder}" TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="2" Classes="ghost" Content="Open" Command="{Binding OpenAppFolderCommand}" />
                <TextBlock Grid.Row="1" Classes="dt" VerticalAlignment="Center" Text="htdocs" />
                <TextBlock Grid.Row="1" Grid.Column="1" Classes="dd mono" VerticalAlignment="Center" Text="{Binding HtdocsFolder}" TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Spacing="4">
                  <Button Classes="ghost" Content="Change" Command="{Binding ChangeHtdocsCommand}" />
                  <Button Classes="ghost" Content="Open" Command="{Binding OpenHtdocsFolderCommand}" />
                </StackPanel>
                <TextBlock Grid.Row="2" Classes="dt" VerticalAlignment="Center" Text="Data" />
                <TextBlock Grid.Row="2" Grid.Column="1" Classes="dd mono" VerticalAlignment="Center" Text="{Binding DataFolder}" TextTrimming="CharacterEllipsis" />
                <Button Grid.Row="2" Grid.Column="2" Classes="ghost" Content="Open" Command="{Binding OpenDataFolderCommand}" />
              </Grid>
              <TextBlock Classes="note" Text="Fully portable: copy the Anvil folder to another drive or PC and it keeps working." />
            </StackPanel>
          </Border>

          <Border Classes="card">
            <StackPanel Spacing="12">
              <TextBlock Classes="h2" Text="Certificates" />
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="dd" VerticalAlignment="Center" Text="Local certificate authority" />
                <Border x:Name="CaStatus" Grid.Column="1" Classes="pill" Classes.ok="{Binding CaTrusted}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Ellipse />
                    <TextBlock Text="{Binding CaStatus}" />
                  </StackPanel>
                </Border>
              </Grid>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="secondary" Content="Trust" Command="{Binding TrustCaCommand}" IsVisible="{Binding !CaTrusted}" />
                <Button Classes="secondary" Content="Re-issue all" Command="{Binding ReissueCommand}" />
                <Button Classes="ghost" Content="Remove from Windows" Command="{Binding UntrustCaCommand}" IsVisible="{Binding CaTrusted}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Classes="card">
            <StackPanel Spacing="12">
              <TextBlock Classes="h2" Text="ArbiPache 3" />
              <TextBlock Classes="para" TextWrapping="Wrap"
                         Text="Brings over the sites ArbiPache 3 kept in %USERPROFILE%\.arbipache. Sites already here are skipped; HTTPS sites get a local development certificate." />
              <Button Classes="secondary" Content="Import from ArbiPache 3" Command="{Binding ImportCommand}" />
              <TextBlock x:Name="ImportMessage" Classes="note" TextWrapping="Wrap" Text="{Binding ImportMessage}"
                         IsVisible="{Binding ImportMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
