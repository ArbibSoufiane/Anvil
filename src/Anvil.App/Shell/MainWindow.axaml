<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="using:Anvil.App.Shell"
        xmlns:vm="using:Anvil.App.ViewModels"
        x:Class="Anvil.App.Shell.MainWindow"
        x:DataType="shell:ShellViewModel"
        Title="Anvil"
        Width="1360" Height="900" MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="40">
  <Window.Resources>
    <shell:PageViewLocator x:Key="PageViews" />
  </Window.Resources>

  <Grid>
  <DockPanel>
    <!-- Title bar: drag area; the system draws the caption buttons on the right. -->
    <Border DockPanel.Dock="Top" Height="40" IsHitTestVisible="False"
            Background="{DynamicResource TitleBarBrush}"
            BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1">
      <StackPanel Orientation="Horizontal" Spacing="12" Margin="16,0,0,0" VerticalAlignment="Center">
        <Viewbox Width="18" Height="18">
          <Canvas Width="24" Height="24">
            <Path Classes="icon" StrokeThickness="2" Stroke="{DynamicResource AccentBrush}"
                  Data="M4 20 L12 4 L20 20 M7.5 13.5 H16.5" />
          </Canvas>
        </Viewbox>
        <TextBlock Text="Anvil" FontWeight="SemiBold" FontSize="13" LetterSpacing="0.3" VerticalAlignment="Center" />
        <TextBlock Text="{Binding Version}" FontSize="12" Classes="dim" VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <!-- Sidebar -->
    <Border x:Name="Sidebar" DockPanel.Dock="Left" Width="232" Padding="12,16"
            Background="{DynamicResource SidebarBrush}"
            BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,1,0">
      <DockPanel>
      <!-- Bottom of the sidebar: Anvil's own update, and the author's GitHub -->
      <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <Panel IsVisible="{Binding HasUpdate}">
          <Button x:Name="UpdateButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  DataContext="{Binding Update}" x:DataType="vm:AppUpdateViewModel"
                  Classes.primary="{Binding UpdateAvailable}" Classes.secondary="{Binding !UpdateAvailable}"
                  Content="{Binding ButtonText}" Command="{Binding ClickCommand}" ToolTip.Tip="{Binding Tip}" />
        </Panel>
        <Button x:Name="InfoButton" Grid.Column="1" Classes="ghost" Padding="8" Command="{Binding OpenGitHubCommand}"
                ToolTip.Tip="{x:Static shell:ShellViewModel.GitHubUrl}">
          <Viewbox Width="18" Height="18">
            <Canvas Width="24" Height="24">
              <Path Classes="icon" Stroke="{Binding $parent[Button].Foreground}"
                    Data="M21 12 A9 9 0 1 1 3 12 A9 9 0 1 1 21 12 Z M12 11 V16.5 M12 7.5 H12.01" />
            </Canvas>
          </Viewbox>
        </Button>
      </Grid>
      <ItemsControl x:Name="Nav" ItemsSource="{Binding NavItems}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="shell:NavItem">
            <Button Classes="nav" Classes.selected="{Binding IsSelected}"
                    Command="{Binding $parent[Window].((shell:ShellViewModel)DataContext).NavigateCommand}"
                    CommandParameter="{Binding Page}">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <Viewbox Width="18" Height="18">
                  <Canvas Width="24" Height="24">
                    <Path Classes="icon" Data="{Binding Icon}"
                          Stroke="{Binding $parent[Button].Foreground}" />
                  </Canvas>
                </Viewbox>
                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      </DockPanel>
    </Border>

    <!-- Content -->
    <Grid Margin="28,24,28,32" RowDefinitions="Auto,*">
      <StackPanel>
        <TextBlock Classes="h1" Text="{Binding Title}" />
        <TextBlock Classes="sub" Text="{Binding Subtitle}" />
      </StackPanel>
      <ContentControl x:Name="PageHost" Grid.Row="1" Margin="0,20,0,0"
                      Content="{Binding CurrentPage}"
                      ContentTemplate="{StaticResource PageViews}" />
    </Grid>
  </DockPanel>

  <!-- Toast: green when all is well, red when not -->
  <Border x:Name="Toast" Classes="toast" Classes.ok="{Binding Toast.Ok}" IsVisible="{Binding Toast.IsVisible}"
          HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,24" MaxWidth="420">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <TextBlock x:Name="ToastText" Text="{Binding Toast.Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
      <Button Grid.Column="1" Classes="ghost" Content="×" Padding="6,0" VerticalAlignment="Top"
              Command="{Binding Toast.CloseCommand}" ToolTip.Tip="Close" />
    </Grid>
  </Border>
  </Grid>
</Window>
