<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Anvil.App.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Anvil/Theme/Tokens.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Dark" Accent="#F08A3C" RegionColor="#0E1116" />
        <ColorPaletteResources x:Key="Light" Accent="#C2601A" RegionColor="#F5F6F8" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://Anvil/Theme/Controls.axaml" />
  </Application.Styles>
</Application>
