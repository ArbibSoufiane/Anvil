# Generated by Anvil. First HTTPS virtual host: refuses host names no site claims.
# It borrows a site's certificate only to complete the handshake.
<VirtualHost *:{{ port }}>
    ServerName anvil-catchall.invalid
    SSLEngine on
    SSLCertificateFile "{{ cert.cert }}"
    SSLCertificateKeyFile "{{ cert.key }}"
{{~ if cert.chain ~}}
    SSLCertificateChainFile "{{ cert.chain }}"
{{~ end ~}}
    ErrorDocument 403 " "
    <Location "/">
        Require all denied
    </Location>
</VirtualHost>
