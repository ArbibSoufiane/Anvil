# Generated by Anvil. First virtual host: answers requests for host names no site claims.
<VirtualHost *:{{ port }}>
    ServerName anvil-catchall.invalid
    DocumentRoot "{{ htdocs }}"
    <Directory "{{ htdocs }}">
        Options {{ options }}
        AllowOverride All
        Require {{ require }}
    </Directory>
{{~ if php_handler ~}}
{{ php_handler }}
{{~ end ~}}
{{~ if entries ~}}
{{ entries }}
{{~ end ~}}
    <LocationMatch "{{ root_guard }}">
        AuthMerging And
        Require {{ require }}
    </LocationMatch>
</VirtualHost>
