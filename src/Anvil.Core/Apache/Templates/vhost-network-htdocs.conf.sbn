# Generated by Anvil. htdocs\{{ folder }} on the local network: http://{{ host }}/
<VirtualHost *:{{ port }}>
    ServerName {{ host }}
    DocumentRoot "{{ root }}"
    <Directory "{{ root }}">
        Options {{ options }}
        AllowOverride All
        Require {{ require }}
    </Directory>
{{~ if php_handler ~}}
{{ php_handler }}
{{~ end ~}}
    <Location "/">
        AuthMerging And
        Require {{ require }}
    </Location>
</VirtualHost>
