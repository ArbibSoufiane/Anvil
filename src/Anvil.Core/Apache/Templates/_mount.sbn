{{~ if alias ~}}
Alias "{{ path }}" "{{ root }}"
{{~ end ~}}
<Directory "{{ root }}">
    Options {{ options }}
    AllowOverride All
    DirectoryIndex {{ index }}
{{ rules }}
{{~ if php ~}}
{{ php }}
{{~ end ~}}
</Directory>
{{~ if guard ~}}
<LocationMatch "{{ guard }}">
    AuthMerging And
{{ rules }}
</LocationMatch>
{{~ end ~}}
