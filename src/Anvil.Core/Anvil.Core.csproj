<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Anvil.Core</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The Agent pipe uses SystemTextJsonFormatter only; PolyType shapes serve formatters we do not use. -->
    <NoWarn>$(NoWarn);StreamJsonRpc0008</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
    <PackageReference Include="Scriban" />
    <PackageReference Include="StreamJsonRpc" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="MySqlConnector" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>
  <ItemGroup>
    <AdditionalFiles Include="Processes\NativeMethods.txt" />
    <AdditionalFiles Include="Elevation\NativeMethods.txt" />
    <AdditionalFiles Include="Update\NativeMethods.txt" />
    <AdditionalFiles Include="Database\NativeMethods.txt" />
    <EmbeddedResource Include="Apache\Templates\*.sbn" LogicalName="Anvil.Templates.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Anvil.Core.Tests" />
  </ItemGroup>
</Project>
